{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "vue", "vitest"],
  "jsPlugins": ["./tools/oxlint/architecture.mjs"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-alert": "error",
    "no-console": "warn",
    "no-await-in-loop": "off",
    "unicorn/no-array-sort": "off",
    "no-restricted-globals": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/consistent-type-imports": "error",
    "arch/no-db-access-in-controllers": "error",
    "arch/no-http-in-services": "error",
    "arch/no-unvalidated-request-reads": "error",
    "arch/no-service-instantiation-outside-container": "error",
    "arch/authorize-before-validate": "error",
    "arch/no-raw-error-throw": "error",
    "arch/zod-schemas-in-shared": "error",
    "arch/no-process-env": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-unsafe-assignment": "off",
        "arch/no-service-instantiation-outside-container": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "tools/**/*.mjs"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
